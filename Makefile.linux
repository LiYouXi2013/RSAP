.PHONY: all clean run

SRCS := $(shell find src -type f -name "*.cpp") main.cpp

OBJS := $(addprefix build/, $(notdir $(SRCS:.cpp=.o)))

CXXFLAGS = -std=c++17 -Wall -Wextra -O2 -I./include

LDFLAGS = -L/usr/local/lib -lfltk -lXrender -lXcursor -lXfixes -lXft -lfontconfig -lXinerama -pthread -lm -lX11 -lspdlog -lfmt

all: $(OBJS)
	cp -r lang/* build/lang/
	g++ -o build/main $(CXXFLAGS) $(OBJS) $(LDFLAGS)

run: all
	cd build && ./main

build/%.o: %.cpp | build
	g++ $(CXXFLAGS) -c $< -o $@

build/%.o: src/%.cpp | build
	g++ $(CXXFLAGS) -c $< -o $@

build/%.o: src/dialogs/%.cpp | build
	g++ $(CXXFLAGS) -c $< -o $@

build:
	mkdir build

